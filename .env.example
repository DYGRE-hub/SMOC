# 이 파일을 .env.local 로 복사해서 채운다.
# 배포할 때는 같은 값을 Vercel 프로젝트의 Environment Variables 에 넣는다.

# ── 필수 ─────────────────────────────────────────────────────
# Postgres 연결 문자열. Neon/Supabase 의 "pooled" 연결을 쓴다.
# 비어 있으면 로컬 파일 저장소(.data/golbang.json)로 뜨는데, 서버리스에서는
# 매 인스턴스마다 초기화되므로 배포 환경에서는 반드시 채워야 한다.
DATABASE_URL=

# 세션 쿠키 서명 키. 아무 긴 무작위 문자열.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# 이 값이 바뀌면 모든 사람이 로그아웃된다. 한 번 정하면 바꾸지 않는다.
SESSION_SECRET=

# ── 선택 ─────────────────────────────────────────────────────
# 가입 문구. 이 문구를 아는 사람만 가입할 수 있다.
# 비워 두면 가입이 아예 막힌다 — 기본값을 코드에 두지 않는다.
SIGNUP_PASSPHRASE=

# 주간 다이제스트 메일. 비워 두면 발송 없이 내용만 돌려준다.
RESEND_API_KEY=
DIGEST_FROM="SMOC 기도의 방 <noreply@example.com>"

# Vercel Cron 이 /api/cron/weekly-digest 를 부를 때 쓰는 값.
# Vercel 에 이 이름으로 환경변수를 넣으면 크론 요청에 자동으로 실려 온다.
CRON_SECRET=

# 로컬 파일 저장소 위치 (개발용). 기본값은 <프로젝트>/.data/golbang.json
GOLBANG_DATA_FILE=
